# ydocter local config — copy to .env and fill in.
# .env is git-ignored; never commit secrets.

# ---- yclaude (Claude CLI gateway) ----
# Base URL of your yclaude server. No trailing slash.
YCLAUDE_BASE_URL=http://dodsas.iptime.org:9091

# Master API key configured on the yclaude server's .env (API_KEY).
# Get this from the operator of the yclaude instance.
YCLAUDE_API_KEY=change-me

# Client label embedded in the JWT — purely for logging on the yclaude side.
YCLAUDE_CLIENT_ID=ydocter

# Optional: which Claude model alias to ask yclaude for. Defaults to
# whatever yclaude has configured as DEFAULT_MODEL.
# YCLAUDE_MODEL=opus

# Timeout (seconds) for the whole /chat round-trip from this app's side.
YCLAUDE_TIMEOUT=120

# ---- ydocter DB ----
# Override only if you want the SQLite file somewhere besides ./data/health.db
# YDOCTER_DB_PATH=/var/data/health.db

# ---- Turso (production persistence) ----
# When BOTH of these are set, the app talks to Turso instead of the local
# SQLite file. Leave them empty for local development.
#
# Get the URL from `turso db show <db>` and the auth token from
# `turso db tokens create <db>`. Token is sensitive — never commit.
# TURSO_DATABASE_URL=libsql://ydocter-dodsas.aws-ap-northeast-1.turso.io
# TURSO_AUTH_TOKEN=

